{
  "expo": {
    "name": "Steady",
    "slug": "steady",
    "scheme": "steady",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F3EF",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Steady opens your contacts only when you pick someone to add as a guardian."
        }
      ]
    ]
  }
}
