{
  "expo": {
    "name": "Steady",
    "slug": "steady",
    "scheme": "steady",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F3EF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steadyreminder.app",
      "infoPlist": {}
    },
    "android": {
      "package": "com.steadyreminder.app",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Steady opens your contacts only when you pick someone to add as a guardian."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Steady",
              "label": "Steady",
              "description": "Your next dose, today's marks and your streak.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen|keyguard"
            }
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8c3fded-bf05-49e9-84e9-cc9b2fc4bda6"
      }
    },
    "owner": "bhccob"
  }
}
